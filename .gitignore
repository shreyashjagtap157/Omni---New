# GitIgnore for Omni Rust workspace

# Compiled binary files and build artifacts
/target/
/CACHE.DIR.TAG
*.db
*.tfm
*.lot

# Cargo and Rust
/target/**
/.cargo/

# IDE and tooling
/.idea/
/.vscode/
/.History/
/.settings/
/.classpath
/.project

# Binary and temp directories
/bin/
/TMPDIR

# Platform-specific
# Windows
/TMPDIR

# Local scratch for the Unicode table generator (UCD downloads are not committed).
/.work/

# Fuzz testing and corpus data (not committed by default)
/tests/fuzz/
/tests/corpus/

# Generated/derived files
*.hex
*.wasm

# Omni-specific generated files
*.output
*.result
*.trace
*.profile
*.stats

# Temporary files
*.tmp
*.temp

# Log files
*.log

# Test output files
test_output.txt
test_out.txt
all_tests.txt
ctrl.txt

# Agent documentation files
.github/agents/**/*.md

# IDE settings
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.idea/workspace.xml
.idea/tasks.xml
