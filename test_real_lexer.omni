struct Token {
    kind: i64,
    val: i64
}

// Token kinds:
// 0: Unknown / Error
// 1: Let
// 2: Mut
// 3: Ident (hash)
// 4: Int literal
// 5: Eq '='
// 6: Semi ';'
// 7: Plus '+'

fn is_whitespace(b: i64) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn is_digit(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

fn is_alpha(b: i64) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

fn main() -> i64 {
    // Source: "let mut x = 42;"
    // ASCII codes:
    // 'l': 108, 'e': 101, 't': 116, ' ': 32
    // 'm': 109, 'u': 117, 't': 116, ' ': 32
    // 'x': 120, ' ': 32
    // '=': 61, ' ': 32
    // '4': 52, '2': 50, ';': 59
    let src = [108, 101, 116, 32, 109, 117, 116, 32, 120, 32, 61, 32, 52, 50, 59];
    let len = 15;

    let mut cursor = 0;
    let mut token_count = 0;
    let mut sum_kinds = 0;
    let mut int_val = 0;

    while cursor < len {
        let b = src[cursor];

        // Skip whitespace
        if is_whitespace(b) {
            cursor += 1;
        } else {
            if is_alpha(b) {
                // Scan identifier or keyword
                let start = cursor;
                let mut h = 0;
                while cursor < len && (is_alpha(src[cursor]) || is_digit(src[cursor])) {
                    h = h * 31 + src[cursor];
                    cursor += 1;
                }
                let span_len = cursor - start;

                // Check keywords: 'let' (108, 101, 116)
                let mut k = 3;
                if span_len == 3 && src[start] == 108 && src[start + 1] == 101 && src[start + 2] == 116 {
                    k = 1;
                } else {
                    // 'mut' (109, 117, 116)
                    if span_len == 3 && src[start] == 109 && src[start + 1] == 117 && src[start + 2] == 116 {
                        k = 2;
                    } else {
                        k = 3;
                    };
                };

                let tok = Token { kind: k, val: h };
                token_count += 1;
                sum_kinds += tok.kind;
            } else {
                if is_digit(b) {
                    // Scan integer literal
                    let mut num = 0;
                    while cursor < len && is_digit(src[cursor]) {
                        num = num * 10 + (src[cursor] - 48);
                        cursor += 1;
                    }
                    let tok = Token { kind: 4, val: num };
                    token_count += 1;
                    sum_kinds += tok.kind;
                    int_val = tok.val;
                } else {
                    if b == 61 {
                        // '='
                        let tok = Token { kind: 5, val: 61 };
                        token_count += 1;
                        sum_kinds += tok.kind;
                        cursor += 1;
                    } else {
                        if b == 59 {
                            // ';'
                            let tok = Token { kind: 6, val: 59 };
                            token_count += 1;
                            sum_kinds += tok.kind;
                            cursor += 1;
                        } else {
                            cursor += 1;
                        };
                    };
                };
            };
        };
    }

    // Expected tokens:
    // 1: 'let' (kind = 1)
    // 2: 'mut' (kind = 2)
    // 3: 'x'   (kind = 3)
    // 4: '='   (kind = 5)
    // 5: '42'  (kind = 4, val = 42)
    // 6: ';'   (kind = 6)
    // Total count = 6
    // Sum kinds = 1 + 2 + 3 + 5 + 4 + 6 = 21
    // Verified return: token_count * 1000 + sum_kinds * 10 + (int_val - 40)
    // 6 * 1000 + 21 * 10 + 2 = 6212
    return token_count * 1000 + sum_kinds * 10 + (int_val - 40);
}
